# =============================================================================
# Microservices — port registry
# =============================================================================
#
# Each persona service binds to a dedicated port.
# The container port is remapped by the orchestrator; these values are not
# externally visible unless you expose them directly (e.g. in docker-compose).
#
# BAYANIHUB_ADMIN_PORT      — LOW sensitivity — default 3301
# BAYANIHUB_ENDUSER_PORT    — LOW sensitivity — default 3302
# BAYANIHUB_SITEMANAGER_PORT — LOW sensitivity — default 3303
#
# HOPECARD_ADMIN_PORT       — LOW sensitivity — default 3101
# HOPECARD_BENE_PORT        — LOW sensitivity — default 3102
# HOPECARD_CM_PORT          — LOW sensitivity — default 3103
# HOPECARD_DONOR_PORT       — LOW sensitivity — default 3104
# HOPECARD_NOTIFICATION_PORT— LOW sensitivity — default 3105
#
# DAMAYAN_ADMIN_PORT        — LOW sensitivity — default 3201
# DAMAYAN_SM_PORT           — LOW sensitivity — default 3202
# DAMAYAN_DISPATCHER_PORT   — LOW sensitivity — default 3203
# DAMAYAN_CITIZEN_PORT      — LOW sensitivity — default 3204
#
# LOCATION_SERVICE_PORT     — LOW sensitivity — default 4010
# -----------------------------------------------------------------------------
BAYANIHUB_ADMIN_PORT=3301
BAYANIHUB_ENDUSER_PORT=3302
BAYANIHUB_SITEMANAGER_PORT=3303

HOPECARD_ADMIN_PORT=3101
HOPECARD_BENE_PORT=3102
HOPECARD_CM_PORT=3103
HOPECARD_DONOR_PORT=3104
HOPECARD_NOTIFICATION_PORT=3105

DAMAYAN_ADMIN_PORT=3201
DAMAYAN_SM_PORT=3202
DAMAYAN_DISPATCHER_PORT=3203
DAMAYAN_CITIZEN_PORT=3204

LOCATION_SERVICE_PORT=4010

# JWT_SECRET — HIGH sensitivity
#              Shared HS256 secret used by all BayaniHub persona services to
#              sign and verify custom JWTs (persona + system claims).
#              Must be at least 32 random bytes. Rotate on breach immediately.
#              Store in Vault / GitHub Secrets — never commit the real value.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-32-byte-secret

# SMTP settings — used by BayaniHub enduser & sitemanager services for OTP email
# SMTP_HOST     — LOW sensitivity
# SMTP_PORT     — LOW sensitivity  (default 587)
# SMTP_USER     — MEDIUM sensitivity
# SMTP_PASS     — HIGH sensitivity — store in Vault / GitHub Secrets
# SMTP_FROM     — LOW sensitivity  — display address in sent emails
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=marco.arante.cics@ust.edu.ph
SMTP_PASS=khkl lqkp hqnd efxc
SMTP_FROM="BayaniHub <no-reply@example.com>"

# DAMAYAN integration — scoped Supabase client for SITEMAN campaigns service
# DAMAYAN_SUPABASE_URL              — LOW sensitivity
# DAMAYAN_SUPABASE_SERVICE_ROLE_KEY — HIGH sensitivity — store in Vault
# Both must be set together; if either is missing the scoped client is disabled.
# -----------------------------------------------------------------------------
DAMAYAN_SUPABASE_URL=https://your-damayan-project.supabase.co
DAMAYAN_SUPABASE_SERVICE_ROLE_KEY=your-damayan-service-role-key-here

# =============================================================================
# Render deployment — environment variable instructions
# =============================================================================
#
# For Render deployments, configure runtime variables in Render Environment
# settings (do not commit a production .env file).
# In production lanes, APICenter values are required so health verification can
# pass with checks.apiCenter=true.
#
# Variables to configure in Render environment settings:
#
#   NODE_ENV                  = production
#   PORT                      = 3000
#   ENABLE_SWAGGER            = false
#   SUPABASE_URL              = https://your-project.supabase.co
#   SUPABASE_ANON_KEY         = <your anon key>
#   SUPABASE_SERVICE_ROLE_KEY = <your service role key>
#   PAYMENT_SERVICE_SUPABASE_URL = https://payment-project.supabase.co
#   PAYMENT_SERVICE_SUPABASE_SECRET_KEY = <payment service role key>
#   CHAT_SERVICE_SUPABASE_URL = https://chat-project.supabase.co
#   CHAT_SERVICE_SUPABASE_SECRET_KEY = <chat service role key>
#   API_CENTER_BASE_URL       = <your APICenter URL>
#   API_CENTER_TRIBE_ID       = <your tribe service id>
#   API_CENTER_TRIBE_SECRET   = <your tribe secret>
#   API_CENTER_API_KEY        = <legacy static key; optional fallback>
#   API_CENTER_TIMEOUT_MS     = 10000
#
#   ALLOWED_ORIGINS — add exact frontend URL(s) for each environment.
#   Example:
#     https://test.example.com,https://uat.example.com,https://app.example.com
#   Do NOT use a bare wildcard (*) — the CORS factory enforces exact matching.
#
# The CI workflow uses Render deploy hooks and health endpoints from GitHub
# Secrets:
#   RENDER_DEPLOY_HOOK_URL_TEST / UAT / MAIN
#   RENDER_HEALTHCHECK_URL_TEST / UAT / MAIN
#   Optional fallback: RENDER_DEPLOY_HOOK_URL, RENDER_HEALTHCHECK_URL
# =============================================================================

